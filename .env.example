# AdMob unit IDs. Leave unset (or delete this file's copy) to keep shipping
# Google's public test ads, which is what the current release does.
#
# To monetize:
#   1. Create the app + ad units at https://apps.admob.com
#   2. Copy .env.example to .env.production and fill both values in
#   3. Replace `admob_app_id` in
#      android/app/src/main/res/values/strings.xml with the real
#      ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY app ID
#   4. npm run cap:sync && cd android && ./gradlew bundleRelease
#
# The app ID in the manifest and these unit IDs must belong to the same
# AdMob account, or the SDK crashes on launch.

VITE_ADMOB_INTERSTITIAL_ID=
VITE_ADMOB_REWARDED_ID=
